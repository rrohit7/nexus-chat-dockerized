# =============================================================================
# Nexus Chat — backend environment template
# =============================================================================
# Copy this file to .env and fill in every value marked REQUIRED.
# Optional values show their built-in default; leave them blank or remove them
# to use the default.  Never commit the real .env to Git.
# =============================================================================


# -----------------------------------------------------------------------------
# Django core
# -----------------------------------------------------------------------------

# REQUIRED — long, random string. Generate with:
#   python -c "import secrets; print(secrets.token_hex(50))"
SECRET_KEY=your-very-long-random-secret-key-here

# Set to False (and fill in ALLOWED_HOSTS) before deploying anywhere but localhost.
# Default when unset: True
DEBUG=True

# Comma-separated list of hostnames Django will serve.
# Default when unset: * (accepts any host — safe only for local dev).
# Example: ALLOWED_HOSTS=chatapp.example.com,www.chatapp.example.com
ALLOWED_HOSTS=


# -----------------------------------------------------------------------------
# PostgreSQL database
# All five values are REQUIRED — there are no built-in defaults.
# In Docker these should match the db service in docker-compose.yml.
# -----------------------------------------------------------------------------

DB_NAME=chatdb
DB_USER=chatuser
DB_PASSWORD=change-this-password
# Docker service name — use "db" inside Compose, "localhost" for manual setup.
DB_HOST=db
DB_PORT=5432


# -----------------------------------------------------------------------------
# MinIO object storage — TWO separate sets of credentials
#
# MINIO_ROOT_* — credentials for the MinIO SERVER ITSELF.
#   Used only by the minio: service in docker-compose.yml (${MINIO_ROOT_USER}).
#   Django does NOT use these directly.
#
# MINIO_ACCESS_KEY / MINIO_SECRET_KEY — credentials the DJANGO BACKEND uses
#   to talk to MinIO via the S3 API (boto3).
#   For a simple single-user setup these can match MINIO_ROOT_*, but they
#   are technically different (one is the MinIO server admin account; the
#   other is the S3 API client key — ideally a dedicated MinIO access key).
#
# All nine values below are REQUIRED for the application to start.
# -----------------------------------------------------------------------------

# MinIO server admin credentials (for the minio container).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-this-minio-password

# Django backend S3 client credentials.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-this-minio-password
MINIO_BUCKET_NAME=chatapp
# Docker service name — use "http://minio:9000" inside Compose.
MINIO_ENDPOINT=http://minio:9000
MINIO_REGION=us-east-1

# PUBLIC_MINIO_URL — the public URL the browser uses to reach MinIO presigned links.
# In the Docker Compose setup, requests are routed through Nginx at /minio/.
# This must NOT be the internal minio:9000 endpoint — that is used only for
# server-to-server S3 API calls (set via MINIO_ENDPOINT above).
# Default when unset: http://localhost:8080/minio (local Compose entry point).
PUBLIC_MINIO_URL=http://localhost:8080/minio


# -----------------------------------------------------------------------------
# File uploads
# Maximum size in MB for a single chat file upload.
# Default when unset: 500 (set by settings.py).
# IMPORTANT: Do NOT leave this blank — an empty value causes a startup crash
# (ValueError: invalid literal for int() with base 10: '').
# -----------------------------------------------------------------------------

MAX_UPLOAD_SIZE_MB=500


# -----------------------------------------------------------------------------
# AI features (DeepSeek)
# REQUIRED — settings.py reads env("DEEPSEEK_API_KEY") with no default.
# Django will raise ImproperlyConfigured on startup if this is missing.
# Get a key at: https://platform.deepseek.com
# If you do not need AI features, set a placeholder value here and the
# application will show an error only when AI endpoints are called
# (see apps/ai/services.py — it checks the key before each call).
# -----------------------------------------------------------------------------

DEEPSEEK_API_KEY=your-deepseek-api-key-here


# -----------------------------------------------------------------------------
# Optional integrations
# Leave blank (or remove the line) to disable a feature.
# -----------------------------------------------------------------------------

# GIF search via Giphy — app works without this; GIF search returns an error.
# Get a free key at: https://developers.giphy.com
GIPHY_API_KEY=


# Google OAuth — Note: allauth Google login credentials are configured through
# the Django admin panel (Admin → Sites → Social applications → Add), NOT via
# environment variables read by settings.py.  The values below are provided
# for reference and local documentation; they are not currently read by the
# Django settings.
GOOGLE_CLIENT_ID=
GOOGLE_SECRET_KEY=


# -----------------------------------------------------------------------------
# Sentry error monitoring (optional)
# Leave SENTRY_DSN blank to disable completely — no code runs, no crash.
# -----------------------------------------------------------------------------

SENTRY_DSN=
# Only used when SENTRY_DSN is set. Default: development
SENTRY_ENVIRONMENT=
# Float, e.g. 0.1 for 10 % of transactions. Default: 0.1
SENTRY_TRACES_SAMPLE_RATE=


# -----------------------------------------------------------------------------
# Web Push notifications (VAPID keys) — optional
# Leave both keys blank to disable push; the app will not crash.
# Generate a keypair with:
#   docker compose exec backend python manage.py generate_vapid_keys
# Then copy the public key to chat-frontend/.env as VITE_VAPID_PUBLIC_KEY.
# -----------------------------------------------------------------------------

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Default when unset: admin@example.com
VAPID_ADMIN_EMAIL=


# -----------------------------------------------------------------------------
# Django admin superuser — created automatically on first startup by
# `python manage.py createadmin` (see backend/apps/users/management/commands/).
# If DJANGO_SUPERUSER_EMAIL or DJANGO_SUPERUSER_PASSWORD is missing,
# createadmin prints a warning and exits gracefully; nothing crashes.
# -----------------------------------------------------------------------------

DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-this-admin-password


# -----------------------------------------------------------------------------
# Celery broker URL
# Only needed for non-Docker (manual) setup.
# In Docker, docker-compose.yml sets CELERY_BROKER_URL=redis://redis:6379/0
# directly in the service environment, overriding this value.
# Default built into settings.py: redis://redis:6379/0
# -----------------------------------------------------------------------------

# CELERY_BROKER_URL=redis://redis:6379/0


# -----------------------------------------------------------------------------
# Coturn TURN/STUN relay — only needed when using the optional Coturn service.
# Start with: docker compose --profile optional up -d coturn
#
# Coturn is configured for REST API short-term credential mode (use-auth-secret).
# The Django backend (Stage B) generates time-limited HMAC tokens per call,
# signed with TURN_AUTH_SECRET.  Static long-term TURN_USERNAME/TURN_PASSWORD
# credentials are no longer used and have been removed from the Compose config.
#
# Security notes:
#   - TURN_AUTH_SECRET must NOT appear in any Vite / frontend build variable.
#   - Container environment variables are visible in `docker inspect .Config.Env`
#     to anyone with Docker socket access — the same limitation applies to all
#     secrets in this project (DB_PASSWORD, SECRET_KEY, etc.).
#   - For production, supply secrets via a secrets manager or encrypted env file
#     rather than a plain .env file on disk.
# -----------------------------------------------------------------------------

# REQUIRED when using Coturn.
# Shared HMAC secret used by the Django backend to sign short-lived TURN tokens.
# Must match the value the Stage B API uses.  Never put this in VITE_* variables.
# Generate with: openssl rand -hex 32
TURN_AUTH_SECRET=replace-with-openssl-rand-hex-32-output

# Authentication realm.  Use your public domain name in production.
TURN_REALM=chatapp.local

# IP address Coturn advertises to WebRTC clients as the relay address.
# Three deployment patterns:
#
#   Local dev (same-machine testing only):
#     TURN_EXTERNAL_IP=127.0.0.1
#     Relay candidates are loopback — reachable only from the same host.
#
#   Production — direct public IP (bare-metal or VPS with public IP on NIC):
#     TURN_EXTERNAL_IP=<public IPv4 address>
#     Use the IP assigned directly to the host's network interface.
#
#   Production — cloud VM behind NAT (AWS EC2, GCP, Azure, etc.):
#     Use Coturn's PUBLIC_IP/PRIVATE_IP format:
#     TURN_EXTERNAL_IP=<public IPv4>/<private NIC IPv4>
#     e.g.: TURN_EXTERNAL_IP=203.0.113.1/10.0.0.5  (replace both values)
#     Without the private IP, Coturn attempts to bind relay sockets to the
#     public address, which is not present on the NIC; relay will silently fail.
#     (203.0.113.x is an RFC 5737 documentation address — not a real IP.)
TURN_EXTERNAL_IP=127.0.0.1

# Host interface(s) to bind TURN listening ports to.
# Local dev: 127.0.0.1  — ports reachable only from localhost.
# Production: 0.0.0.0   — ports reachable from all network interfaces.
#             (also ensure your firewall allows UDP/TCP 3478 and UDP 49160-49200)
TURN_LISTEN_IP=127.0.0.1

# UDP relay port range.  Must match the Docker port-publishing range above AND
# the firewall rules on the host.  Change both together if you need a different
# range; the default 49160-49200 supports up to ~20 simultaneous relay sessions.
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200

# ── Django TURN credential API (Stage B) ──────────────────────────────────
# These variables are read by the Django backend (settings.py), not by Coturn.
# Both the backend container and the Coturn container share the same .env file,
# so TURN_AUTH_SECRET only needs to be set once.
#
# TURN_SERVER_URL: public TURN URL sent to WebRTC clients by the backend API.
#   Local dev: turn:localhost:3478
#   Production: turn:<your-public-ip-or-domain>:3478
#   Do NOT use the Docker-internal service name (e.g. coturn:3478) — clients
#   are browsers, not containers.
TURN_SERVER_URL=turn:localhost:3478
#
# TURN_CREDENTIAL_TTL: how long (in seconds) issued credentials remain valid.
#   Default: 600 (10 minutes).  Increase for long calls; decrease for tighter
#   security.  Must be less than the call duration you want to support.
TURN_CREDENTIAL_TTL=600
